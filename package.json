{
  "name": "flashcards",
  "version": "0.2.1",
  "description": "An Anki integration.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w --environment BUILD:dev",
    "build": "esbuild main.ts --bundle --external:obsidian --format=cjs --platform=browser --target=es2018 --outfile=main.js --sourcemap=inline",
    "build:rollup": "rollup --config rollup.config.js --environment BUILD:production",
    "release": "npm run build && mkdir -p dist/better-flashcards && cp main.js manifest.json dist/better-flashcards/",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "obsidian",
    "anki",
    "flashcards"
  ],
  "author": "Mihir Patel, Karol Szykuła",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "esbuild": "0.28.1",
    "eslint": "10.9.0",
    "globals": "16.5.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "^30.5.1",
    "obsidian": "https://github.com/obsidianmd/obsidian-api/tarball/master",
    "obsidian-test-mocks": "5.1.0",
    "rollup": "4.62.4",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.1",
    "tslib": "2.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@types/showdown": "1.9.3",
    "showdown": "1.9.1"
  }
}
